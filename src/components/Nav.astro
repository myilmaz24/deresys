---
import emblem from '../assets/emblem-orange.svg?raw';
import wordmark from '../assets/word-dark.svg?raw';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/cozumler', label: 'Çözümler' },
  { href: '/hakkinda', label: 'Hakkında' },
  { href: '/blog', label: 'Blog' },
  { href: '/iletisim', label: 'İletişim' },
];
const isActive = (href) => path === href || path.startsWith(href + '/');

// Olay müdahale talebi — doğrudan WhatsApp'a yönlendirir. Bkz. COPY.md — Site geneli.
const whatsappNumber = '905521238956';
const whatsappMessage = 'Merhaba, bir güvenlik olayıyla ilgili DERESYS ile iletişime geçmek istiyorum.';
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---
<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label="DERESYS ana sayfa">
      <span class="brand__emblem" set:html={emblem} />
      <span class="brand__word" set:html={wordmark} />
    </a>

    <button class="nav__toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Menüyü aç">
      <span></span><span></span><span></span>
    </button>

    <nav id="nav-menu" class="nav__menu" aria-label="Ana menü">
      <ul class="nav__list">
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={['nav__link', { 'is-active': isActive(l.href) }]}
               aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <div class="nav__ctas">
        <a
          class="btn btn--secondary nav__cta nav__cta--incident"
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="whatsapp-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.29-.15-1.7-.84-1.97-.93-.26-.1-.46-.15-.65.14-.19.29-.75.93-.92 1.12-.17.19-.34.22-.63.07-.29-.15-1.22-.45-2.32-1.43-.86-.76-1.44-1.71-1.6-2-.17-.29-.02-.44.13-.59.13-.13.29-.34.44-.5.15-.17.19-.29.29-.48.1-.19.05-.36-.02-.5-.07-.15-.65-1.58-.9-2.16-.24-.57-.48-.5-.65-.5-.17-.01-.36-.01-.56-.01-.19 0-.5.07-.77.36-.26.29-1 .98-1 2.4s1.03 2.78 1.17 2.97c.15.19 2.03 3.1 4.93 4.35.69.3 1.22.48 1.64.61.69.22 1.31.19 1.81.11.55-.08 1.7-.7 1.94-1.37.24-.67.24-1.25.17-1.37-.07-.12-.26-.19-.55-.34z" />
            <path d="M12.02 2C6.5 2 2.02 6.48 2.02 12c0 1.87.5 3.63 1.44 5.16L2 22l4.97-1.4A9.94 9.94 0 0 0 12.02 22C17.55 22 22 17.52 22 12S17.55 2 12.02 2zm0 18.2c-1.66 0-3.2-.48-4.5-1.32l-.32-.2-3.02.85.85-2.94-.21-.33a8.17 8.17 0 0 1-1.28-4.36c0-4.53 3.68-8.2 8.48-8.2 4.5 0 8.16 3.67 8.16 8.2 0 4.53-3.66 8.3-8.16 8.3z" />
          </svg>
          Olay müdahale talebi
        </a>
        <a class="btn btn--primary nav__cta" href="/iletisim">Görüşme talep edin</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg-surface-1);
    border-bottom: 1px solid var(--border-subtle);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: var(--nav-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand__emblem :global(svg) { height: 26px; width: auto; }
  .brand__word :global(svg) { height: 15px; width: auto; }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    text-decoration: none;
    padding-block: 6px;
    position: relative;
    transition: color 140ms ease;
  }
  .nav__link:hover { color: var(--text-primary); }
  .nav__link.is-active { color: var(--text-primary); }
  /* Ray — aktif durum işareti */
  .nav__link.is-active::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 2px;
    background: var(--color-accent);
  }
  .nav__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .nav__cta { padding: 10px 18px; }
  .nav__cta--incident { white-space: nowrap; }
  .whatsapp-icon { flex-shrink: 0; }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    cursor: pointer;
    padding: 0 9px;
  }
  .nav__toggle span {
    display: block;
    height: 1.5px;
    background: var(--text-primary);
    transition: transform 140ms ease, opacity 140ms ease;
  }

  @media (max-width: 900px) {
    .nav__inner { flex-wrap: wrap; gap: var(--space-4); }
    .nav__toggle { display: flex; }
    .nav__menu {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      width: 100%;
      padding-bottom: var(--space-6);
    }
    .nav__menu.is-open { display: flex; }
    .nav__list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav__list li { border-top: 1px solid var(--border-subtle); }
    .nav__link { display: block; padding: var(--space-4) 0; }
    .nav__link.is-active::after { display: none; }
    .nav__link.is-active { color: var(--color-accent); }
    .nav__ctas { flex-direction: column; align-items: stretch; gap: var(--space-3); }
    .nav__cta { justify-content: center; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav__toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
  });
</script>
