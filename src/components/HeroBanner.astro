---
import PageHead from './PageHead.astro';

// Sayfa üstü banner: solda metin, sağda görsel. Görsel 1600x900.
const { image, imageAlt, eyebrow, title, lead } = Astro.props;
---
<div class="hero">
  {image && <img class="hero__img" src={image} alt={imageAlt} width="1600" height="900" fetchpriority="high" decoding="async" />}
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__text">
    <PageHead eyebrow={eyebrow} title={title} lead={lead}><slot /></PageHead>
  </div>
</div>

<style>
  .hero { position: relative; overflow: hidden; background: #000; }
  .hero__img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: right center;
  }
  .hero__shade {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, #000 0%, rgba(0,0,0,0.85) 35%, rgba(0,0,0,0) 70%);
  }
  .hero__text { position: relative; }
  .hero__text :global(.phead__lead) { max-width: 46ch; }
  @media (max-width: 900px) {
    .hero__img { opacity: 0.45; }
    .hero__shade { background: linear-gradient(180deg, rgba(0,0,0,0.6), #000 100%); }
  }
</style>
