---
import Base from './Base.astro';
import PageHead from '../components/PageHead.astro';
import Cta from '../components/Cta.astro';
import SupportedTechnologies from '../components/SupportedTechnologies.astro';

const { service } = Astro.props;
const { metaTitle, description, eyebrow, title, lead, componentsTitle, components, outputs, fit, note, image, imageAlt, figure } = service;
---
<Base title={`${metaTitle} | DERESYS`} description={description} image={image}>
  <div class="hero">
    {image && <img class="hero__img" src={image} alt={imageAlt} width="1600" height="900" fetchpriority="high" decoding="async" />}
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__text">
      <PageHead eyebrow={eyebrow} title={title} lead={lead} />
    </div>
  </div>

  <section class="section">
    <div class="wrap stack stack-12">
      <div class="block" id="bilesenler">
        <h2 class="h-sm block__title">{componentsTitle}</h2>
        <div class="components">
          {components.map((c) => (
            <div class="component">
              <span class="eyebrow eyebrow--accent">{c.code}</span>
              <h3 class="subheading">{c.title}</h3>
              <p class="muted">{c.body}</p>
              {c.fit && <p class="dim small">{c.fit}</p>}
            </div>
          ))}
        </div>
      </div>

      {figure && (
        <figure class="figure">
          <img src={figure.src} alt={figure.alt} width="1600" height="900" loading="lazy" decoding="async" />
        </figure>
      )}

      <div class="block" id="ciktilar">
        <h2 class="h-sm block__title">Çıktılar</h2>
        <ul class="prose muted">
          {outputs.map((o) => <li><strong>{o.name}</strong> — {o.body}</li>)}
        </ul>
      </div>

      <div class="block" id="kimler-icin">
        <h2 class="h-sm block__title">Kimler için uygun</h2>
        <div class="stack stack-4">
          <p class="muted">{fit}</p>
          {note && <p class="dim small">{note}</p>}
        </div>
      </div>
    </div>
  </section>

  <SupportedTechnologies />
  <Cta />
</Base>

<style>
  .hero { position: relative; overflow: hidden; background: #000; }
  .hero__img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: right center;
  }
  .hero__shade {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, #000 0%, rgba(0,0,0,0.85) 35%, rgba(0,0,0,0) 70%);
  }
  .hero__text { position: relative; }
  .hero__text :global(.phead__lead) { max-width: 46ch; }
  .figure { margin: 0; border: 1px solid var(--border-subtle); border-radius: var(--radius-card); overflow: hidden; }
  .figure img { display: block; width: 100%; height: auto; }
  @media (max-width: 900px) {
    .hero__img { opacity: 0.45; }
    .hero__shade { background: linear-gradient(180deg, rgba(0,0,0,0.6), #000 100%); }
  }
  .block { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-16); align-items: start; }
  .block__title { padding-top: 2px; }
  .components { display: grid; gap: var(--space-8); }
  .component {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--bg-surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: var(--card-padding);
  }
  ul.prose { padding-left: 1.1em; display: grid; gap: var(--space-2); }
  @media (max-width: 900px) { .block { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
