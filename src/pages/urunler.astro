---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Draft from '../components/Draft.astro';
---
<Base title="Ürünler | DERESYS" description="Üçüncü taraf siber güvenlik ürünleri tedariki.">
  <PageHead eyebrow="ÜRÜNLER" title="Ürünler" lead="Üçüncü taraf üreticilerin siber güvenlik ürünlerini tedarik ediyoruz.">
    <p class="muted prose head-follow">
      Bu iş kolu danışmanlık hizmetlerimizden ayrı yürüyor. Değerlendirme veya olgunluk
      programı müşterimizseniz size ürün satmıyoruz.
    </p>
  </PageHead>

  <section class="section">
    <div class="wrap stack stack-12">
      <div class="block">
        <h2 class="h-sm">Ürün grupları</h2>
        <Draft need="Hangi üreticiler ve ürün kategorileri. Bayilik anlaşması bulunmayan üretici adı yazılmaz." />
      </div>

      <div class="block">
        <h2 class="h-sm">Tedarik talebi</h2>
        <div class="stack stack-6">
          <p class="muted prose">Belirli bir ürün için teklif almak isterseniz iletişime geçebilirsiniz.</p>
          <div class="btn-row"><a class="btn btn--secondary" href="/iletisim">İletişim</a></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .head-follow { margin-top: var(--space-4); }
  .block { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-16); align-items: start; }
  @media (max-width: 900px) { .block { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
