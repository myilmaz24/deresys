---
import Base from '../layouts/Base.astro';
import emblem from '../assets/emblem-orange.svg?raw';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const dateFmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });

const services = [
  {
    code: 'DH',
    title: 'Danışmanlık Hizmetleri',
    body: 'Güvenlik olgunluğunuzu ölçer, olay müdahale hazırlığınızı kurar ve vCISO olarak bilgi güvenliği yönetişimini üstleniriz.',
    note: 'Olay Müdahalesi, vCISO ve Siber Güvenlik Olgunluk Programı bu başlık altında.',
    href: '/cozumler#danismanlik',
  },
  {
    code: 'OH',
    title: 'Operasyonel Hizmetler',
    body: 'SIEM ortamınızın işletimsel sağlığını ve tespit kapsamını periyodik olarak doğrular, Splunk destek ve kural ihtiyaçlarınızı karşılarız.',
    note: 'MSS ve Splunk Destek ve Kural İçeriği bu başlık altında.',
    href: '/cozumler#operasyonel',
  },
  {
    code: 'SGA',
    title: 'Siber Güvenlik Akademisi',
    body: 'Bilgi işlem ve güvenlik ekibinizi olay müdahalesinde uygulamalı, laboratuvar ağırlıklı eğitimle hazırlarız.',
    note: 'Olay Müdahale Eğitimi bu başlık altında.',
    href: '/cozumler#akademi',
  },
];
---
<Base
  title="DERESYS — Siber Güvenlik Danışmanlığı"
  description="Danışmanlık hizmetleri, operasyonel hizmetler ve siber güvenlik akademisi ile siber güvenlik yapınızı değerlendirir ve geliştiririz."
>
  <section class="hero">
    <div class="hero__mark" aria-hidden="true" set:html={emblem} />
    <div class="wrap hero__inner">
      <h1 class="display hero__title">Güvenli, akıllı, sürekli</h1>
      <div class="stack stack-6 hero__body">
        <p class="lead">
          DERESYS, kurumların siber güvenlik yapısını değerlendiren ve geliştiren bir
          danışmanlık şirketidir. Üç başlıkta çalışıyoruz: danışmanlık hizmetleri, operasyonel
          hizmetler ve siber güvenlik akademisi.
        </p>
        <p class="muted">
          Çalışmalarımız genellikle aynı soruyla başlıyor. Bir güvenlik yatırımı yapılmış,
          araçlar kurulmuş, süreçler tanımlanmış oluyor; ama bunların gerçekte ne kadarının
          efektif bir koruma sağladığı kurum içinden bakınca net görünmüyor.
        </p>
        <p class="muted">
          Bu noktada DERESYS kendine özgü metodolojilerle, yapılan yatırımlardan en yüksek
          faydayı ve korumayı sağlamak üzere planı çıkarır ve programı kurumla birlikte
          uygulamaya koyar.
        </p>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="wrap">
      <div class="grid grid--3">
        {services.map((s) => (
          <a class="card card--ray" href={s.href}>
            <span class="eyebrow eyebrow--accent">{s.code}</span>
            <h2 class="h-sm">{s.title}</h2>
            <p class="muted small">{s.body}</p>
            <p class="dim small">{s.note}</p>
            <span class="card__foot arrow-link">
              Ayrıntılar
              <svg class="chev" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="square" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <span class="eyebrow">BLOG</span>
          <h2 class="h">Yazdıklarımız</h2>
        </div>
        <div class="stack stack-8">
          <p class="lead prose">
            Nasıl çalıştığımızı görmek isterseniz blogu okuyabilirsiniz. Tespit kuralları,
            SIEM içerik yönetimi, olay müdahale pratiği ve uyum çerçeveleri üzerine yazıyoruz.
          </p>
          <div class="stack stack-4 blog-teaser">
            {latestPosts.map((post) => (
              <a class="teaser-post" href={`/blog/${post.slug}`}>
                <span class="dim small"><time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time></span>
                <span class="teaser-post__title">{post.data.title}</span>
              </a>
            ))}
          </div>
          <a class="arrow-link" href="/blog">
            Tüm yazılar
            <svg class="chev" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5"
                    stroke-linecap="square" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <span class="eyebrow">İLETİŞİM</span>
          <h2 class="h">Nereden başlanır</h2>
        </div>
        <div class="stack stack-8">
          <p class="lead prose">
            Hangi hizmetin size uyduğundan emin değilseniz kısa bir görüşme genellikle yeterli
            oluyor. Mevcut durumunuzu dinleyip nereden başlamanın mantıklı olacağını konuşuruz.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/iletisim">Görüşme talep edin</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--section-gap) * 1.15) var(--section-gap);
    background-image: radial-gradient(circle at 72% 34%, rgba(255, 68, 0, 0.06), transparent 58%);
  }
  .hero__inner { position: relative; z-index: 1; }
  .hero__title {
    margin-top: 0;
    max-width: none;
    font-size: clamp(22px, 4.4vw, 44px);
  }
  .hero__body { margin-top: var(--space-8); max-width: 62ch; }

  /* İmza: amblem ışınları sağ kenardan taşarak giriyor */
  .hero__mark {
    position: absolute;
    top: 50%;
    right: -22%;
    transform: translateY(-50%);
    width: 860px;
    opacity: 0.05;
    pointer-events: none;
  }
  .hero__mark :global(svg) { width: 100%; height: auto; }

  @media (max-width: 1100px) {
    .hero__mark { right: -28%; width: 620px; opacity: 0.05; }
  }
  @media (max-width: 720px) {
    .hero__mark { right: -40%; width: 460px; opacity: 0.04; }
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-16);
    align-items: start;
  }
  .split .eyebrow { margin-bottom: var(--space-4); }

  .blog-teaser { border-top: 1px solid var(--border-subtle); padding-top: var(--space-4); }
  .teaser-post {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    padding-block: var(--space-2);
  }
  .teaser-post__title {
    font-weight: var(--weight-medium);
    transition: color 140ms ease;
  }
  .teaser-post:hover .teaser-post__title { color: var(--color-accent); }

  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
