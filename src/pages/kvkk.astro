---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Draft from '../components/Draft.astro';
---
<Base title="KVKK Aydınlatma Metni | DERESYS">
  <PageHead eyebrow="YASAL" title="KVKK Aydınlatma Metni" />

  <section class="section">
    <div class="wrap stack stack-8">
      <Draft need={'Hukuki metindir, taslak yazılmaz. Şu bilgiler olmadan hazırlanamaz: ticari unvan, açık adres, MERSIS numarası, veri sorumlusu iletişim bilgisi.'} />
      <div class="note">
        <span class="eyebrow">AYRICA NETLEŞTİRİLMELİ</span>
        <p class="muted small">
          Form verisinin nerede saklandığı, saklama süresi ve varsa yurt dışına aktarım durumu.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .note {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-6);
    max-width: var(--prose-max-width);
    display: flex; flex-direction: column; gap: var(--space-3);
  }
</style>
