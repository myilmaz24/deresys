---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Draft from '../components/Draft.astro';
---
<Base title="İletişim | DERESYS" description="Görüşme talebi ve iletişim bilgileri.">
  <PageHead
    eyebrow="İLETİŞİM"
    title="İletişim"
    lead="Hangi hizmetin size uyduğundan emin değilseniz kısa bir görüşme genellikle yeterli oluyor. Mevcut durumunuzu dinleyip nereden başlamanın mantıklı olacağını konuşuruz."
  />

  <section class="section">
    <div class="wrap contact">
      <div class="contact__form">
        <h2 class="h-sm">Görüşme talebi</h2>
        <p id="c-success" class="form-success" hidden>
          Talebiniz alındı. En kısa sürede size dönüş yapacağız.
        </p>
        <form
          id="c-form"
          class="form-grid"
          method="post"
          action="https://formsubmit.co/info@deresys.com.tr"
        >
          <input type="hidden" name="_subject" value="Yeni görüşme talebi — deresys.com.tr" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_next" value="https://deresys.com.tr/iletisim?gonderildi=1" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <div class="field">
            <label for="c-name">Ad soyad</label>
            <input id="c-name" name="ad" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="c-org">Kurum</label>
            <input id="c-org" name="kurum" type="text" autocomplete="organization" required />
          </div>
          <div class="field">
            <label for="c-mail">E-posta</label>
            <input id="c-mail" name="eposta" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="c-tel">Telefon <span class="dim">(opsiyonel)</span></label>
            <input id="c-tel" name="telefon" type="tel" autocomplete="tel" />
          </div>
          <div class="field field--full">
            <label for="c-msg">Mesaj</label>
            <textarea id="c-msg" name="mesaj" required></textarea>
          </div>
          <div class="field--full">
            <button class="btn btn--primary" type="submit">Gönder</button>
          </div>
        </form>
        <p class="form-note">
          Bıraktığınız bilgiler yalnızca talebinize dönüş yapmak için kullanılır.
          <a class="link" href="/kvkk">KVKK Aydınlatma Metni</a>
        </p>
      </div>

      <aside class="contact__side">
        <h2 class="h-sm">Doğrudan iletişim</h2>
        <dl class="dl">
          <dt class="eyebrow">E-POSTA</dt>
          <dd><a class="link" href="mailto:info@deresys.com.tr">info@deresys.com.tr</a></dd>
        </dl>
        <Draft need={'Telefon\nAdres'} />
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1.7fr 1fr; gap: var(--space-16); align-items: start; }
  .contact__form { display: flex; flex-direction: column; gap: var(--space-8); }
  .contact__side {
    display: flex; flex-direction: column; gap: var(--space-6);
    background: var(--bg-surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: var(--card-padding);
  }
  .dl { margin: 0; display: grid; gap: var(--space-2); }
  .dl dd { margin: 0; }
  .mt { margin-top: 0; }
  .form-success {
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-control);
    color: var(--text-primary);
    font-size: var(--text-body-sm);
  }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; gap: var(--space-10); } }
</style>

<script>
  // FormSubmit, gönderimden sonra _next ile ?gonderildi=1 parametresine döner.
  if (new URLSearchParams(window.location.search).has('gonderildi')) {
    document.getElementById('c-success')?.removeAttribute('hidden');
    document.getElementById('c-form')?.setAttribute('hidden', '');
    window.history.replaceState({}, '', window.location.pathname);
  }
</script>
