---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Draft from '../components/Draft.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Blog — Siber Güvenlik Teknik İçerik | DERESYS"
  description="Tespit kuralları, SIEM içerik yönetimi, olay müdahalesi ve uyum çerçeveleri üzerine teknik yazılar."
>
  <PageHead
    eyebrow="BLOG"
    title="Blog"
    lead="Tespit kuralları, SIEM içerik yönetimi, olay müdahale pratiği ve uyum çerçeveleri üzerine yazıyoruz. Yazıların çoğu sahada karşılaştığımız somut problemlerden çıkıyor."
  />

  <section class="section">
    <div class="wrap stack stack-6">
      {posts.map((post) => (
        <a class="line card--ray" href={`/blog/${post.slug}`}>
          <div class="line__main">
            <span class="eyebrow eyebrow--accent">
              <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
              {post.data.tags?.length > 0 && <> · {post.data.tags.join(', ')}</>}
            </span>
            <h2 class="subheading">{post.data.title}</h2>
            <p class="muted">{post.data.description}</p>
          </div>
          <div class="line__go">
            <span class="arrow-link">
              Oku
              <svg class="chev" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="square" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <hr class="rule" />

  <section class="section">
    <div class="wrap">
      <div class="block">
        <h2 class="h-sm">Yeni yazılardan haberdar olun</h2>
        <div class="stack stack-6">
          <p class="muted prose">
            Yeni yazı yayınlandığında e-posta gönderiyoruz, başka bir gönderi yapmıyoruz.
          </p>
          <form class="inline-form" method="post" action="#">
            <div class="field">
              <label for="blog-email">E-posta</label>
              <input id="blog-email" name="email" type="email" autocomplete="email" placeholder="ad@kurum.com.tr" required />
            </div>
            <button class="btn btn--primary" type="submit">Abone ol</button>
          </form>
          <p class="form-note">
            Aboneliğinizi her e-postadaki bağlantıdan sonlandırabilirsiniz.
          </p>
          <Draft label="ENTEGRASYON BEKLİYOR" need="Form gönderim adresi (VPS endpoint) ve e-posta listesi altyapısı bağlanmadı." />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .block { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-16); align-items: start; }
  @media (max-width: 900px) { .block { grid-template-columns: 1fr; gap: var(--space-8); } }

  .line {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-8);
    align-items: start;
    background: var(--bg-surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    text-decoration: none;
    color: inherit;
    transition: background-color 140ms ease, border-color 140ms ease;
  }
  a.line:hover { background: var(--bg-surface-2); border-color: var(--border-strong); }
  .line__main { display: flex; flex-direction: column; gap: var(--space-3); }
  .line__go { padding-top: 4px; }

  .card--ray::before {
    content: "";
    position: absolute;
    top: -1px;
    left: var(--space-8);
    width: 40px;
    height: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 140ms ease, width 140ms ease;
  }
  a.card--ray:hover::before { opacity: 1; width: 72px; }

  @media (max-width: 900px) {
    .line { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>
