---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';

const groups = [
  {
    id: 'danismanlik',
    eyebrow: 'DANIŞMANLIK HİZMETLERİ',
    title: 'Danışmanlık Hizmetleri',
    intro: 'Kurumunuzun güvenlik yapısını değerlendirir, hazırlar ve yönetişimini üstleniriz.',
    lines: [
      {
        code: 'OM',
        title: 'Olay Müdahalesi',
        body: 'Hazırlık projesi, masabaşı tatbikat ve müdahale hattıyla ekibinizin olay anında ne yapacağını önceden bilmesini sağlarız.',
        fit: 'Şu durumda uygun: bir olay planınız var ama hiç denenmedi; ya da ekipte müdahale deneyimi sınırlı ve bunu olay anında keşfetmek istemiyorsunuz.',
        href: '/cozumler/olay-mudahalesi',
      },
      {
        code: 'vCISO',
        title: 'vCISO',
        body: 'İhtiyacınıza göre üç modelde çalışırız: şirketinizin fiilen CISO’su gibi görev alırız, mevcut ekibinize ikinci göz sağlarız ya da doğrudan yönetim kurulunuza brifing veririz.',
        fit: 'Şu durumda uygun: tam zamanlı bir CISO’ya bütçeniz yok, ama SPK, BDDK, Siber Güvenlik Kanunu veya EPDK gibi bir düzenleme sizi bilgi güvenliğinden üst yönetim seviyesinde sorumlu tutuyor.',
        href: '/cozumler/vciso',
      },
      {
        code: 'OP',
        title: 'Siber Güvenlik Olgunluk Programı',
        body: 'Güvenlik kontrollerinizin mevcut durumunu ölçer, puanlar ve önceliklendirilmiş bir iyileştirme planı üretiriz.',
        fit: 'Şu durumda uygun: yatırım yapılmış ama bütünsel resim yok; ya da yönetime mevcut durumu ve gidilecek yeri ölçülebilir biçimde anlatmanız gerekiyor.',
        href: '/cozumler/olgunluk-programi',
      },
      {
        code: 'SOC',
        title: 'SOC Danışmanlığı',
        body: 'SOC kurmayı planlıyorsanız kurulum danışmanlığıyla, mevcut bir SOC/MSSP’niz varsa bağımsız etkinlik denetimiyle, SOC bütçeniz yoksa periyodik sağlık kontrolüyle yanınızda oluruz.',
        fit: 'Şu durumda uygun: SOC kurmayı planlıyorsunuz, mevcut bir SOC/MSSP’nin ürettiği tespitlerin kapsamını bağımsız bir gözle görmek istiyorsunuz ya da SOC bütçeniz yokken periyodik bir sağlık kontrolü arıyorsunuz.',
        href: '/cozumler/soc-danismanligi',
      },
    ],
  },
  {
    id: 'operasyonel',
    eyebrow: 'OPERASYONEL HİZMETLER',
    title: 'Operasyonel Hizmetler',
    intro: 'Güvenlik çözümlerinizin gün geçtikçe sağlıklı ve güncel kalmasını sürekli hâle getiririz.',
    lines: [
      {
        code: 'MSS',
        title: 'MSS — Güvenlik Teknolojileri Yönetim ve Takip Hizmeti',
        body: 'Splunk ve IBM QRadar gibi SIEM ortamlarınızı periyodik olarak kontrol eder, işletimsel sağlığını ve MITRE ATT&CK’e göre tespit kapsamını düzenli raporlarla size sunarız.',
        fit: 'Şu durumda uygun: kurumsal bir SIEM’e yatırım yaptınız ama bunu sürekli sağlıklı tutacak uzmanlık kapasiteniz sınırlı; ya da hizmet aldığınız bir MSSP’nin ürettiği tespitlerin kapsamını bağımsız bir gözle görmek istiyorsunuz.',
        href: '/cozumler/mss',
      },
      {
        code: 'SPL',
        title: 'Splunk Destek ve Kural İçeriği',
        body: 'Splunk ortamınızda kural geliştirme, içerik bakımı ve teknik destek sağlarız.',
        fit: 'Şu durumda uygun: Splunk kullanıyorsunuz ve kural/içerik tarafında sürekli bir uzmanlık desteğine ihtiyacınız var.',
        href: '/cozumler/splunk-destek',
      },
    ],
  },
  {
    id: 'akademi',
    eyebrow: 'SİBER GÜVENLİK AKADEMİSİ',
    title: 'Siber Güvenlik Akademisi',
    intro: 'Ekibinizi olay müdahalesinde uygulamalı eğitimle hazırlarız.',
    lines: [
      {
        code: 'OM-1',
        title: 'Olay Müdahale Eğitimi',
        body: 'Bilgi işlem ve güvenlik ekibiniz için 3 günlük, laboratuvar ağırlıklı uygulamalı eğitim; delil bozmadan hareket etme, doğru sırayla toplama, zaman çizelgesi çıkarma ve raporlama.',
        fit: 'Şu durumda uygun: ekibinizin olay anında ilk 60 dakikada ne yapacağını netleştirmek istiyorsunuz; adli inceleme deneyimi aranmaz.',
        href: '/cozumler/olay-mudahale-egitimi',
      },
    ],
  },
];
---
<Base
  title="Hizmetler — Siber Güvenlik Danışmanlık Hizmetleri | DERESYS"
  description="Danışmanlık hizmetleri, operasyonel hizmetler ve siber güvenlik akademisi: olay müdahalesi, vCISO, olgunluk programı, MSS, Splunk destek ve olay müdahale eğitimi."
>
  <PageHead
    eyebrow="HİZMETLER"
    title="Siber güvenlik danışmanlık hizmetleri"
    lead="Hizmetlerimizi üç başlıkta topluyoruz: danışmanlık hizmetleri, operasyonel hizmetler ve siber güvenlik akademisi. Her biri ayrı alınabilir, birlikte alındığında da birbirini tekrar etmez."
  >
    <p class="muted prose lead-follow">
      Aşağıdaki kısa tariflerden hangisinin durumunuza benzediğine bakabilirsiniz.
    </p>
  </PageHead>

  {groups.map((g) => (
    <Fragment>
    <section class="section group" id={g.id}>
      <div class="wrap stack stack-6">
        <div class="group__head">
          <span class="eyebrow eyebrow--accent">{g.eyebrow}</span>
          <h2 class="h">{g.title}</h2>
          <p class="muted prose group__intro">{g.intro}</p>
        </div>

        {g.lines.map((l) => (
          <a class="line card--ray" href={l.href}>
            <div class="line__code"><span class="eyebrow eyebrow--accent">{l.code}</span></div>
            <div class="line__main">
              <h3 class="subheading">{l.title}</h3>
              <p class="muted">{l.body}</p>
              <p class="dim small">{l.fit}</p>
            </div>
            <div class="line__go">
              <span class="arrow-link">
                Ayrıntılar
                <svg class="chev" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
    <hr class="rule" />
    </Fragment>
  ))}
</Base>

<style>
  .lead-follow { margin-top: var(--space-4); }

  .group__head { max-width: var(--prose-max-width); }
  .group__intro { margin-top: var(--space-3); }

  .line {
    position: relative;
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: var(--space-8);
    align-items: start;
    background: var(--bg-surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: var(--card-padding);
    text-decoration: none;
    color: inherit;
    transition: background-color 140ms ease, border-color 140ms ease;
  }
  a.line:hover { background: var(--bg-surface-2); border-color: var(--border-strong); }
  .line__code { padding-top: 6px; }
  .line__main { display: flex; flex-direction: column; gap: var(--space-3); }
  .line__go { padding-top: 4px; }

  .card--ray::before {
    content: "";
    position: absolute;
    top: -1px;
    left: var(--space-8);
    width: 40px;
    height: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 140ms ease, width 140ms ease;
  }
  a.card--ray:hover::before { opacity: 1; width: 72px; }

  .excl { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-16); align-items: start; }
  .excl .eyebrow { margin-bottom: var(--space-4); }

  @media (max-width: 900px) {
    .line { grid-template-columns: 1fr; gap: var(--space-4); }
    .line__code { padding-top: 0; }
    .excl { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
