---
const { eyebrow, title, lead } = Astro.props;
---
<section class="phead">
  <div class="wrap">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="h-lg phead__title">{title}</h1>
    {lead && <p class="lead prose phead__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phead {
    padding-block: calc(var(--section-gap) * 0.85) calc(var(--section-gap) * 0.55);
    border-bottom: 1px solid var(--border-subtle);
  }
  .phead__title { margin-top: var(--space-5, 20px); max-width: 20ch; }
  .phead__lead { margin-top: var(--space-6); }
</style>
