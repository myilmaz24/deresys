---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Draft from '../../components/Draft.astro';
import Cta from '../../components/Cta.astro';

const sections = [
  { id: 'om-1', code: 'OM-1', title: 'Olay müdahale eğitimi', need: 'Hedef katılımcı, süre, içerik başlıkları.' },
  { id: 'om-2', code: 'OM-2', title: 'Olay müdahale hazırlık projesi', need: 'Kapsam, çıktı, süre.' },
  { id: 'om-3', code: 'OM-3', title: 'Masabaşı tatbikat', need: 'Senaryo yapısı, katılımcı profili, süre, çıktı.' },
];
---
<Base title="Olay Müdahale Hazırlığı ve Tatbikat | DERESYS">
  <PageHead eyebrow="OM · OLAY MÜDAHALESİ" title="Olay müdahale hazırlığı">
    <div class="head-draft"><Draft need="Hazırlığın müdahale kalitesini nasıl belirlediğini anlatan bir paragraf." /></div>
  </PageHead>

  <section class="section">
    <div class="wrap stack stack-12">
      {sections.map((s) => (
        <div class="block" id={s.id}>
          <div class="block__head">
            <span class="eyebrow eyebrow--accent">{s.code}</span>
            <h2 class="h-sm">{s.title}</h2>
          </div>
          <Draft need={s.need} />
        </div>
      ))}

      <div class="block" id="om-4">
        <div class="block__head">
          <span class="eyebrow eyebrow--accent">OM-4</span>
          <h2 class="h-sm">Olay müdahale hattı</h2>
        </div>
        <div class="stack stack-6">
          <p class="muted">Abonelik modeliyle sunulacak müdahale hattı hazırlık aşamasındadır.</p>
          <a class="arrow-link" href="/hotline">
            Olay Müdahale Hattı
            <svg class="chev" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />
  <Cta />
</Base>

<style>
  .head-draft { margin-top: var(--space-8); max-width: var(--prose-max-width); }
  .block { display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-16); align-items: start; }
  .block__head { display: flex; flex-direction: column; gap: var(--space-3); }
  @media (max-width: 900px) { .block { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
