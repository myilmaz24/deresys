# Depoda her şey LF ile saklanır.
* text=auto eol=lf

# Bunlar sunucuda çalışacak — CRLF olursa "bad interpreter" hatası verir
*.sh        text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# İkili dosyalara dokunma
*.png       binary
*.jpg       binary
*.jpeg      binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.zip       binary
*.ico       binary
